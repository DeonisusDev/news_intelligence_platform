# Copy to .env and fill in real values. Never commit the real .env file.

# --- Postgres (shared instance: Airflow metadata DB + application "newsdata" DB) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
NEWSDATA_DB=newsdata

# --- MinIO (S3-compatible raw JSON landing zone) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=raw-news-data

# --- ClickHouse (analytical warehouse: raw/stage/ods/mart + summary_articles) ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DB=default

# --- Airflow ---
AIRFLOW_UID=50000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_WWW_USER=airflow
AIRFLOW_WWW_PASSWORD=airflow
# Must be identical across every Airflow container: the scheduler signs a JWT per task so its
# supervisor can call back to the api-server's execution API, and the api-server verifies that
# JWT with the same secret. If these were left to Airflow's random per-process default, each
# container would generate a different value and every task would fail with 403 Forbidden.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=

# --- NewsAPI.org (free Developer tier: 100 req/day, ~24h delay, content truncated ~260 chars) ---
# Top headlines, not keyword search - see docs/adr/0006-top-headlines-multi-source.md.
NEWSAPI_API_KEY=
# Comma-separated /v2/top-headlines categories the ingestion DAG loops through each run.
NEWSAPI_CATEGORIES=business,entertainment,general,health,science,sports,technology
# Hard cap on NewsAPI calls per DAG run - keeps a comfortable margin under the 100/day free-tier quota.
NEWSAPI_MAX_REQUESTS_PER_RUN=20

# --- GNews.io (free tier: 100 req/day, max 10 articles/request, no pagination) ---
# Second, independent top-headlines source - same story is more likely covered by at least one
# provider. Get a free key at https://gnews.io.
GNEWS_API_KEY=
# Comma-separated /v4/top-headlines categories the ingestion DAG loops through each run.
GNEWS_CATEGORIES=general,world,nation,business,technology,entertainment,science,health,sports
# Hard cap on GNews calls per DAG run (one request per category on the free tier).
GNEWS_MAX_REQUESTS_PER_RUN=20

# --- LLM enrichment via OpenRouter (OpenAI-SDK-compatible; swap base_url/model to change provider) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# --- FastAPI auth (Phase 6.5) ---
# Signs the login JWT (see fastapi_app/auth.py). Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
